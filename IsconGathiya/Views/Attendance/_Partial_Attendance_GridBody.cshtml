@using IsconGathiya.ViewModel
@using IsconGathiya.Common
@model EmployeeViewModel

@{
    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
}

<link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/datatables.css")">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.5/dist/sweetalert2.min.css" rel="stylesheet" />

<form asp-controller="Attendance" method="post" id="changeBranchForm">

    <table class="table table-striped table-bordered display w-100" style="width:100%" id="basic-2">
        <thead>
            <tr>
                <th scope="col" class="text-center">Select</th>
                <th scope="col" class="text-center">Employee Name</th>
                <th scope="col" class="text-center">Branch</th>
                <th scope="col" class="text-center">Shift</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.employeeDetailsList == null || !Model.employeeDetailsList.Any())
            {
                <tr>
                    <td class="text-center text-danger" colspan="12"><strong>No data found</strong></td>
                </tr>
            }
            else
            {
                foreach (var item in Model.employeeDetailsList)
                {
                    <tr class="jsgrid-row @(item.IsActive.HasValue && item.IsActive.Value ? "bg-light-success" : "bg-light-danger")">
                        <td class="text-center">
                            <div class="form-check form-switch justify-content-center d-flex">
                                <input class="form-check-input toggle-active"
                                       type="checkbox"
                                       role="switch"
                                       id="toggle-@item.EmployeeId"
                                       name="SelectedEmployeeIds"
                                       value="@item.EmployeeId"
                                       data-employee-id="@item.EmployeeId" />
                            </div>
                        </td>
                        <td class="text-center">@item.EmployeeName</td>
                        <td class="text-center">@item.BranchName</td>
                        <td class="text-center">
                            @(item.Shift != null ? Enums.GetEnumDescription<Enums.Shift>((int)item.Shift) : "_")
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="text-center my-3">
        <button type="submit" class="btn btn-primary" id="saveButton">Save</button>
    </div>

</form>

<script src="@Url.Content("~/assets/js/datatable/datatables/jquery.dataTables.min.js")"></script>
<script src="@Url.Content("~/assets/js/datatable/datatables/datatable.custom.js")"></script>
<script src="@Url.Content("~/viewjs/dev-script.js")"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.5/dist/sweetalert2.all.min.js"></script>

