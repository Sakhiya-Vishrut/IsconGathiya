@using IsconGathiya.ViewModel
@using IsconGathiya.Common
@model EmployeeViewModel


<form asp-controller="Attendance" asp-action="SaveAttendance" method="post">
    <table class="table table-striped table-bordered display w-100">
        <thead>
            <tr>
                <th class="text-center">Select</th>
                <th class="text-center">Employee Name</th>
                <th class="text-center">Branch</th>
                <th class="text-center">Shift</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.employeeDetailsList == null || !Model.employeeDetailsList.Any())
            {
                <tr>
                    <td class="text-center text-danger" colspan="12"><strong>No data found</strong></td>
                </tr>
            }
            else
            {
                for (int j = 0; j < Model.employeeDetailsList.Count; j++)
                {
                    var item = Model.employeeDetailsList[j];
                    <tr class="jsgrid-row @(item.IsActive.HasValue && item.IsActive.Value ? "bg-light-success" : "bg-light-danger")">
                        <td class="text-center">
                            <div class="form-check form-switch justify-content-center d-flex">
                                <input class="form-check-input toggle-active"
                                       type="checkbox"
                                       role="switch"
                                       id="toggle-@item.EmployeeId"
                                       onchange="setStatus(@item.EmployeeId)" />
                            </div>
                            <input type="hidden" name="attendanceDetailsList[@j].Status" id="emp-@item.EmployeeId" value="2"/>
                        </td>
                        <td class="text-center">
                            <input type="hidden" name="attendanceDetailsList[@j].EmployeeId" value="@item.EmployeeId" />
                            @item.EmployeeName
                        </td>
                        <td class="text-center">@item.BranchName</td>
                        <td class="text-center">
                            @(item.Shift != null ? Enums.GetEnumDescription<Enums.Shift>((int)item.Shift) : "_")
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="text-center my-3">
        <button type="submit" class="btn btn-primary" id="saveButton">Save</button>
    </div>
</form>
