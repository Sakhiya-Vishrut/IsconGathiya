@using IsconGathiya.ViewModel
@using IsconGathiya.Helper
@using IsconGathiya.Common
@using IsconGathiya.ViewModel
@model EmployeeViewModel
@{
    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
}

<div class="container-fluid">
    <div class="row">
        <!-- Daily Entry Table Start -->
        <div class="col-sm-12">
            <div class="card p-3">
                <div class="card-block row">
                    <div class="col-sm-12 col-lg-12 col-xl-12">
                        <div class="table-responsive custom-scrollbar">
                            <table class="table table-striped table-bordered display w-100" style="width:100%">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-center">No</th>
                                        <th scope="col" class="text-center">Branch</th>
                                        <th scope="col" class="text-center">Employee Name</th>
                                        <th scope="col" class="text-center">Shift</th>
                                    </tr>
                                </thead>
                                <tbody>
@*                                     @if (Model.TotalCount < 1)
                                    {
                                        <tr>
                                            <td class="text-center text-danger" colspan="12"><strong>No data found</strong></td>
                                        </tr>
                                    } *@
                                    @foreach (var item in Model.employeeDetailsList)
                                    {
                                        <tr class="jsgrid-row @(item.IsActive.HasValue && item.IsActive.Value ? "bg-light-success" : "bg-light-danger")">
                                            <td class="text-center">@(i++)</td>
                                            <td class="text-center">@item.BranchName</td>
                                            <td class="text-center">@item.EmployeeName</td>
                                            <td class="text-center">
                                                @(item.Shift != null ? Enums.GetEnumDescription<Enums.Shift>((int)item.Shift) : "_")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Daily Entry Table Start -->
    </div>
</div>

