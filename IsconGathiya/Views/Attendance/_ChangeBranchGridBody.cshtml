@using IsconGathiya.ViewModel
@using IsconGathiya.Common
@model EmployeeViewModel

@{
    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
}
<div class="container">

<table class="table table-striped table-bordered display w-100" style="width:100%" id="basic-1">
    <thead>
        <tr>
            <th scope="col" class="text-center">Select</th>
            <th scope="col" class="text-center">Employee Name</th>
            <th scope="col" class="text-center">Branch</th>
            <th scope="col" class="text-center">Shift</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.employeeDetailsList == null || !Model.employeeDetailsList.Any())
        {
            <tr>
                <td class="text-center text-danger" colspan="12"><strong>No data found</strong></td>
            </tr>
        }
        else
        {
            foreach (var item in Model.employeeDetailsList)
            {
                <tr class="jsgrid-row @item.IsActive">
                    <td class="text-center">
                        <div class="form-check form-switch justify-content-center d-flex">
                            <input class="form-check-input toggle-active"
                                   type="checkbox"
                                   role="switch"
                                   id="toggle-@item.EmployeeId"
                                   data-employee-id="@item.EmployeeId" />
                        </div>
                    </td>
                    <td class="text-center">@item.EmployeeName</td>
                    <td class="text-center">@item.BranchName</td>
                    <td class="text-center">
                        @(item.Shift != null ? Enums.GetEnumDescription<Enums.Shift>((int)item.Shift) : "_")
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<div class="text-center my-3">
    <button type="submit" class="btn btn-primary" id="saveButton">Save</button>
</div>
</div>