@using IsconGathiya.Common
@using IsconGathiya.ViewModel
@model EmployeeViewModel

<link rel="stylesheet" href="~/Viewcss/Attendance.css" />

<div class="table-wrapper">
    <form method="post">
        <input type="hidden" name="shiftType" value="@Model.employeeDetails.Shift" />
        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="text-center">Branch</th>
                        <th class="text-center">Shift</th>
                        <th class="text-center">Employee</th>
                        <th class="text-center">Sign out</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.employeeDetailsList == null || !Model.employeeDetailsList.Any())
                    {
                        <tr>
                            <td class="no-data text-center" colspan="4">
                                <i class="fas fa-info-circle"></i>
                                <strong>No Employee Records</strong>
                                <p>Add employees to start tracking attendance</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (int j = 0; j < Model.employeeDetailsList.Count; j++)
                        {
                            var item = Model.employeeDetailsList[j];
                            <tr class="jsgrid-row @(item.IsActive.HasValue && item.IsActive.Value ? "bg-light-success" : "bg-light-danger") text-center">
                                <input type="hidden" name="attendanceDetailsList[@j].EmployeeId" value="@item.EmployeeId" />
                                <input type="hidden" name="attendanceDetailsList[@j].AttendancId" value="@(item.AttendanceId ?? 0)" />

                                <td>
                                    <span class="branch-badge">@item.BranchName</span>
                                </td>
                                <td>
                                    <span class="shift-badge">
                                        @(item.Shift != null ? Enums.GetEnumDescription<Enums.Shift>((int)item.Shift) : "-")
                                    </span>
                                </td>
                                @if (item.AttendanceId.HasValue || Model.IsAttendanceCompleted)
                                {
                                    bool isPresent = item.AttendanceStatus == 1;
                                    <td>
                                        <span class="@(isPresent ? "status-present" : "status-absent")">
                                            @item.EmployeeName
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center">
                                            <!-- Sign Out Button -->
                                            <a type="button" asp-action="SignoutEmployee" asp-controller="Attendance" class="btn btn-danger status-absent sign-out-btn" id="signOut-@item.EmployeeId">
                                                Sign Out
                                            </a>
                                        </div>
                                        <input type="hidden" name="attendanceDetailsList[@j].Status" id="emp-@item.EmployeeId" value="@item.AttendanceStatus" />
                                    </td>

                                }
                                else
                                {
                                    <td>
                                        <div class="form-check d-flex justify-content-center">
                                            <input class="form-check-input custom-checkbox"
                                                   type="checkbox"
                                                   id="toggle-@item.EmployeeId"
                                                   onchange="setStatus(@item.EmployeeId)" />
                                            <label class="custom-checkbox-label" for="toggle-@item.EmployeeId"></label>
                                        </div>
                                        <input type="hidden" name="attendanceDetailsList[@j].Status" id="emp-@item.EmployeeId" value="2" />
                                    </td>
                                    <td>
                                        <span class="status-absent">
                                            @item.EmployeeName
                                        </span>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </form>
</div>
