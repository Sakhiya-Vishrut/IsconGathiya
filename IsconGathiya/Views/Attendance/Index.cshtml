@using IsconGathiya.ViewModel
@using IsconGathiya.Helper
@using IsconGathiya.Common
@model EmployeeViewModel

<div class="container-fluid mt-2">
    <div class="row">
        <div class="col-sm-12">
            <div class="card p-3">
                <div class="card-block row">
                    <!-- Shift Dropdown -->
                    <div class="col-md-9">
                        @if (Model.ShiftTypeList != null && Model.ShiftTypeList.Any())
                        {
                            DateTime currentUtcTime = DateTime.UtcNow;

                            TimeZoneInfo indiaTimeZone = TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
                            DateTime indianStandardTime = TimeZoneInfo.ConvertTimeFromUtc(currentUtcTime, indiaTimeZone);

                            TimeSpan now = indianStandardTime.TimeOfDay;

                            bool isDayTime = now >= TimeSpan.FromHours(7) && now < TimeSpan.FromHours(19);

                            <div id="ShiftSwitchGroup" class="d-flex flex-wrap gap-2">
                                @foreach (var shift in Model.ShiftTypeList)
                                {
                                    var shiftTextLower = shift.Text.ToLower();
                                    var isDayShift = shiftTextLower == "day";
                                    var shouldBeChecked = (isDayShift && isDayTime) || (!isDayShift && !isDayTime);
                                    var shouldBeDisabled = (isDayShift && !isDayTime) || (!isDayShift && isDayTime);

                                    <input type="radio" class="btn-check"
                                           name="shiftType"
                                           value="@shift.Value"
                                           id="shift_@shift.Value"
                                           autocomplete="off"
                                           @(shouldBeChecked ? "checked" : "")
                                           @(shouldBeDisabled ? "disabled" : "") />

                                    <label class="btn btn-outline-primary @(shouldBeDisabled ? "disabled" : "")" for="shift_@shift.Value">@shift.Text</label>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-md-3 py-2">
                        @{
                            var currentNow = DateTime.Now;
                            var isBetweenMidnightAnd7AM = currentNow.TimeOfDay < TimeSpan.FromHours(7);
                            var displayDate = isBetweenMidnightAnd7AM ? currentNow.AddDays(-1) : currentNow;
                        }
                        <h5 class="mb-0 text-muted">
                            @displayDate.ToString("dddd, dd MMMM yyyy")
                        </h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grid Body Container -->
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card p-3">
                <div class="card-block row">
                    <div id="AttendanceTableContainer">
                        <partial name="_Partial_Attendance_GridBody" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section BodyEndScript {

    <script>
        $(document).ready(function () {
            const $shiftInputs = $('#ShiftSwitchGroup input[type=radio][name=shiftType]');

            $shiftInputs.on('change', function () {
                const shiftValue = $(this).val();

                if (!shiftValue) {
                    alert("Please select a valid shift.");
                    return;
                }

                fnShowMainProgress();

                $.ajax({
                    url: '@Url.Action("GetEmployeesAttendenceByShift", "Attendance")',
                    type: 'GET',
                    data: { shiftType: shiftValue },
                    success: function (response) {
                        $('#AttendanceTableContainer').html(response);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error loading data:", xhr.status, error);
                        alert("Error loading employee data. Please try again.");
                    },
                    complete: function () {
                        fnHideMainProgress();
                    }
                });
            });

            $shiftInputs.filter(':checked').trigger('change');
        });
    </script>
}