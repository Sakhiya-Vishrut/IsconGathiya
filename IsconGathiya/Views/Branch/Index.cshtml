@using IsconGathiya.Helper
@using IsconGathiya.ViewModel
@model BranchViewModel
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-6">
                <h4>Default</h4>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="index.html">
                            <svg class="stroke-icon">
                                <use href="../assets/svg/icon-sprite.svg#stroke-home"></use>
                            </svg>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Dashboard</li>
                    <li class="breadcrumb-item active">Default</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid my-5">
    <div class="card border-0 rounded-4 shadow">
        <div class="card-header text-white text-center py-3 rounded-top-4">
            <h4 class="mb-0 fw-bold">Branch List</h4>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover table-responsive-md" id="example3">
                    <thead class="text-center bg-light">
                        <tr>
                            <th scope="col" class="fw-semibold">No</th>
                            <th scope="col" class="fw-semibold">Branch Name</th>
                            <th scope="col" class="fw-semibold">Address</th>
                            <th scope="col" class="fw-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in Model.branchDetailsList.Select((value, index) => new { value, index }))
                        {
                            <tr class="text-center border-bottom">
                                <td>@(branch.index + 1)</td>
                                <td>@branch.value.BranchName</td>
                                <td>@branch.value.Address</td>
                                <td>
                                    <a asp-action="BranchForm"
                                       asp-controller="Branch"
                                       asp-route-encodedBranchId="@branch.value.BranchId.Encode()"
                                       class="btn btn-primary btn-sm shadow-sm me-2"
                                       title="Edit">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm shadow-sm"
                                       title="Delete"
                                       onclick="fnBranchDelete1modal('@branch.value.BranchId.Encode()')">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
