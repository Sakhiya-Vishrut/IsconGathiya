@using IsconGathiya.ViewModel
@model BranchViewModel

@{
    ViewData["Title"] = Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row align-items-center">
            <div class="col-6">
                <h4>@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</h4>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Branch</li>
                        <li class="breadcrumb-item active" aria-current="page">@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="vertical-main-wizard">
                        <div class="row">
                            <div class="col-xxl-12 col-xl-12 col-12">
                                <div class="tab-content" id="wizard-tabContent">
                                    <div class="tab-pane fade show active px-4" id="wizard-contact" role="tabpanel" aria-labelledby="wizard-contact-tab">
                                        <form asp-action="AddeditBranch" asp-controller="Branch" class="needs-validation custom-input" method="post">
                                            <input type="hidden" asp-for="branchDetails.BranchId" />
                                            <input type="hidden" id="countryDropDown" value="@Model.branchDetails.CountryId" />
                                            <input type="hidden" id="StateId" value="@Model.branchDetails.StateId">
                                            <input type="hidden" id="CityId" value="@Model.branchDetails.CityId" />

                                            <!-- Row 1: Branch Name & Country -->
                                            <div class="row mb-3">
                                                <!-- Branch Name -->
                                                <div class="col-md-6">
                                                    <label class="form-label" for="BranchName">Branch Name<span class="txt-danger">*</span></label>
                                                    <input type="text" class="form-control text-uppercase" asp-for="branchDetails.BranchName" id="BranchName" required placeholder="Enter Branch Name">
                                                    <span asp-validation-for="branchDetails.BranchName" class="invalid-feedback"></span>
                                                </div>

                                                <!-- Country -->
                                                <div class="col-md-6">
                                                    <label class="form-label" for="countryDropDown">Country</label>
                                                    <select class="form-control w-100 select2-state"
                                                            id="countryDropDown"
                                                            onchange="loadStatesByCountry(this.value)"
                                                            asp-for="branchDetails.CountryId"
                                                            asp-items="@(new SelectList(Model.branchDetails.CountryList, "Id", "Name", "101"))"
                                                            data-placeholder="Select Country" required>
                                                    </select>
                                                    <span asp-validation-for="branchDetails.CountryId" class="invalid-feedback"></span>

                                                </div>
                                            </div>

                                            <!-- Row 2: State & City -->
                                            <div class="row mb-3">
                                                <!-- State -->
                                                <div class="col-md-6">
                                                    <label class="form-label" for="stateDropDown">State</label>
                                                    <select class="form-control w-100 select2-state"
                                                            id="stateDropDown"
                                                            onchange="loadCitiesByState(this.value)"
                                                            asp-for="branchDetails.StateId"
                                                            data-placeholder="Select State" required>
                                                        <option value="">-- Select State --</option>
                                                    </select>
                                                    <span asp-validation-for="branchDetails.StateId" class="invalid-feedback"></span>

                                                </div>

                                                <!-- City -->
                                                <div class="col-md-6">
                                                    <label class="form-label" for="cityDropDown">City</label>
                                                    <select class="form-control w-100 select2-state"
                                                            id="cityDropDown"
                                                            asp-for="branchDetails.CityId"
                                                            data-placeholder="Select City" required>
                                                        <option value="">-- Select City --</option>
                                                    </select>
                                                    <span asp-validation-for="branchDetails.CityId" class="invalid-feedback"></span>
                                                </div>
                                            </div>

                                            <!-- Row 3: Address (Full Width) -->
                                            <div class="row mb-3">
                                                <div class="col-md-12">
                                                    <label class="form-label" for="validationTextarea">Address<span class="txt-danger">*</span></label>
                                                    <textarea class="form-control text-uppercase"
                                                              asp-for="branchDetails.Address"
                                                              id="validationTextarea"
                                                              required
                                                              placeholder="Enter Address"
                                                              rows="3"></textarea>
                                                    <span asp-validation-for="branchDetails.Address" class="invalid-feedback"></span>
                                                </div>
                                            </div>

                                            <!-- Save/Reset Buttons -->
                                            <div class="btn-showcase text-center">
                                                <button class="btn btn-primary" type="submit">Save</button>
                                                <button class="btn btn-dark" type="reset">Reset</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

