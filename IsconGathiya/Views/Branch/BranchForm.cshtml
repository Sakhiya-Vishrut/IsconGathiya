@using IsconGathiya.ViewModel
@model BranchViewModel

@{
    ViewData["Title"] = Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row align-items-center">
            <div class="col-6">
                <h4>@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</h4>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Branch</li>
                        <li class="breadcrumb-item active" aria-current="page">@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header text-white text-center py-4 rounded-top-4">
            <h3 class="mb-0 fw-bold">Branch Registration Form</h3>
        </div>
        <div class="card-body p-5">
            <form asp-controller="Branch" asp-action="AddeditBranch" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="branchDetails.BranchId" />

                <!-- Branch Information Section -->
                <h5 class="mb-4 text-primary fw-semibold">Branch Information</h5>
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label for="branchName" class="form-label fw-medium">Branch Name <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control rounded-3"
                               id="branchName"
                               asp-for="branchDetails.BranchName"
                               placeholder="Enter branch name"
                               required
                               maxlength="100" />
                        <span asp-validation-for="branchDetails.BranchName" class="text-danger"></span>
                    </div>
                </div>

                <!-- Address Section -->
                <h5 class="mb-4 text-primary fw-semibold">Address Details</h5>
                <div class="row g-3 mb-4">
@*                     <div class="col-md-6">
                        <label for="state" class="form-label fw-medium">State <span class="text-danger">*</span></label>
                        <select class="form-select rounded-3"
                                id="state"
                                asp-for="branchDetails.StateId"
                                required>
                            <option value="">Select a state</option>
                            @if (Model?.States != null)
                            {
                                foreach (var state in Model.States)
                                {
                                    <option value="@state.Id">@state.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="branchDetails.StateId" class="text-danger"></span>
                    </div>
 *@@*                     <div class="col-md-6">
                        <label for="city" class="form-label fw-medium">City <span class="text-danger">*</span></label>
                        <select class="form-select rounded-3"
                                id="city"
                                asp-for="branchDetails.CityId"
                                required>
                            <option value="">Select a city</option>
                            @if (Model?.Cities != null)
                            {
                                foreach (var city in Model.Cities)
                                {
                                    <option value="@city.Id">@city.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="branchDetails.CityId" class="text-danger"></span>
                    </div>
 *@                </div>
                <div class="mb-4">
                    <label for="address" class="form-label fw-medium">Address <span class="text-danger">*</span></label>
                    <textarea class="form-control rounded-3"
                              id="address"
                              asp-for="branchDetails.Address"
                              placeholder="Enter full address"
                              rows="4"
                              required
                              maxlength="500"></textarea>
                    <span asp-validation-for="branchDetails.Address" class="text-danger"></span>
                </div>

                <!-- Form Actions -->
                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-3 px-4 me-2">Submit</button>
                    <a href="@Url.Action("Index", "Branch")" class="btn btn-secondary btn-lg rounded-3 px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>