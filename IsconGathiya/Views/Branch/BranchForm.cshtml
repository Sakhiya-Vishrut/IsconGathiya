@using IsconGathiya.ViewModel
@model BranchViewModel

@{
    ViewData["Title"] = Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row align-items-center">
            <div class="col-6">
                <h4>@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</h4>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Branch</li>
                        <li class="breadcrumb-item active" aria-current="page">@(Model?.branchDetails?.BranchId == 0 ? "Add Branch" : "Edit Branch")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="vertical-main-wizard">
                        <div class="row">
                            <div class="col-xxl-12 col-xl-12 col-12">
                                <div class="tab-content" id="wizard-tabContent">
                                    <div class="tab-pane fade show active px-4" id="wizard-contact" role="tabpanel" aria-labelledby="wizard-contact-tab">
                                        <form asp-action="AddeditBranch" asp-controller="Branch" class="needs-validation custom-input" method="post">
                                            <input type="hidden" asp-for="branchDetails.BranchId" />

                                            <!-- Branch Name (Horizontal Layout) -->
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="BranchName">Branch Name<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control" asp-for="branchDetails.BranchName" id="validationTooltip04" required="" placeholder="Enter Branch Name" id="BranchName">
                                                    <span asp-validation-for="branchDetails.BranchName" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <!-- Address (Vertical Layout) -->
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="txtAddress">Address<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <textarea class="form-control border w-100" asp-for="branchDetails.Address" id="validationTooltip04" required="" placeholder="Enter Address" rows="3"></textarea>
                                                    <span asp-validation-for="branchDetails.Address" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <!-- Save/Reset Buttons -->
                                            <div class="btn-showcase text-center">
                                                <button class="btn btn-primary" type="submit">Save</button>
                                                <button class="btn btn-dark" type="reset">Reset</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Container-fluid Ends-->