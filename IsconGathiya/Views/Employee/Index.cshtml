@using IsconGathiya.ViewModel
@model EmployeeViewModel
@{
    var gridUrl = Url.RouteUrl("Employee_Filter");
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-6">
                <h4>Default</h4>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="index.html">
                            <svg class="stroke-icon">
                                <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                            </svg>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Dashboard</li>
                    <li class="breadcrumb-item active">Default</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid">
    <div class="row">
        <!-- Filter Button Start -->
        <div class="col-lg-12 d-flex justify-content-start ms-md-auto mb-3 mt-3">
            <button class="btn bg-primary btn-lg d-flex align-items-center gap-2" type="button" data-bs-toggle="tooltip" title="btn btn-success btn-lg" id="filter-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="24" height="24" fill="none" stroke="white" stroke-miterlimit="10" stroke-width="4">
                    <polygon points="2 6 2 10 26 34 26 58 38 58 38 34 62 10 62 6 2 6"></polygon>
                </svg>
                <span class="text-white">Filter</span>
            </button>
        </div>

        <!-- Filter Button End -->
    </div>
    <div class="row mb-2" id="filter-form">
        <!-- Filter Form Start -->
        <div class="col-sm-12">
            <div class="card height-equal">
                <div class="card-body basic-wizard important-validation">
                    <div id="msform p-3">
                        <div class="stepper-one row needs-validation custom-input" novalidate="">

                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="stateSelect">State</label>
                                <select class="form-control w-100 select2-state gridFilterElements"
                                        id="stateDropDown"
                                        onchange="loadCitiesByState(this.value)"
                                        asp-for="employeeDetails.StateId"
                                        data-placeholder="Select State" required>
                                    <option value="">-- Select State --</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid State.</div>
                            </div>
                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="citySelect">City</label>
                                <select class="form-control selectMode w-100 rounded border select2-city gridFilterElements"
                                        id="cityDropDown"
                                        asp-for="employeeDetails.CityId"
                                        data-placeholder="Select City" required>
                                    <option value="">-- Select City --</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid City.</div>
                            </div>
                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="citySelect">Shift</label>
                                @if (Model.ShiftTypeList != null && Model.ShiftTypeList.Any())
                                {
                                    <select class="form-control selectMode w-100 rounded border select2-city gridFilterElements "
                                            id="ShiftDropdown"
                                            asp-items="Model.ShiftTypeList"
                                            data-placeholder="Select ShiftType" required>
                                        <option value="">Select Shift</option>
                                    </select>
                                }
                            </div>

                            <div class="col-sm-3">
                                <label class="form-label required-validation">Branch</label>
                                <select class="form-control selectMode w-100 rounded border select2-city gridFilterElements"
                                    id="BranchDropDown"
                                    asp-for="employeeDetails.BranchId"
                                    asp-items="@(new SelectList(Model.employeeDetails.BranchList, "BranchId", "BranchName"))"
                                    data-placeholder="Select Branch" required>
                                    <option value="">Select Branch</option>
                                </select>
                            </div>
                            <div class="wizard-footer d-flex justify-content-end gap-2 col-lg-12 col-md-12 col-sm-12 mt-3">
                                <button class="btn btn-primary" onclick="GridPagination('employeeList_Grid',1,'@gridUrl','ClientUserID')">Search</button>
                                <button class="btn btn-danger" onclick="Clearfilter(); GridPagination('employeeList_Grid',1,'@gridUrl','ClientUserID');" type="button">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Filter Form end -->
    </div>
</div>
<div id="employeeList_Grid">
    <partial name="_Partial_Employee_GridBody" />
</div>
@section BodyModalSection {
    <div class="modal fade" id="EmployeeViewModal" tabindex="-1" aria-labelledby="serviceDetailsLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header bg-primary">
                    <h5 class="modal-title text-white" id="serviceDetailsLabel">Employee Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="EmployeeViewModelBody">
                </div>

                <div class="modal-footer">~
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>

            </div>
        </div>
    </div>
}
@section BodyEndScript {
    <script src="@Url.Content("~/viewjs/Employee.js")"></script>
    <script src="~/viewjs/pagination.js"></script>

    <script>
        var getEmployeeDelete = "@Url.RouteUrl("Employee_Delete")";
        var getEmployeeViewModel = "@Url.RouteUrl("EmployeeViewModal")";
    </script>
}