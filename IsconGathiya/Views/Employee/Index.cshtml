@using IsconGathiya.ViewModel
@model EmployeeViewModel
@{
    var gridUrl = Url.RouteUrl("Complain_Filter");
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-6">
                <h4>Default</h4>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="index.html">
                            <svg class="stroke-icon">
                                <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                            </svg>
                        </a>
                    </li>
                    <li class="breadcrumb-item">Dashboard</li>
                    <li class="breadcrumb-item active">Default</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid">
    <div class="row">
        <!-- Filter Button Start -->
        <div class="col-lg-12 d-flex justify-content-start ms-md-auto mb-3 mt-3">
            <button class="btn bg-primary btn-lg d-flex align-items-center gap-2" type="button" data-bs-toggle="tooltip" title="btn btn-success btn-lg" id="filter-button">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="24" height="24" fill="none" stroke="white" stroke-miterlimit="10" stroke-width="4">
                    <polygon points="2 6 2 10 26 34 26 58 38 58 38 34 62 10 62 6 2 6"></polygon>
                </svg>
                <span class="text-white">Filter</span>
            </button>
        </div>

        <!-- Filter Button End -->
    </div>
    <div class="row mb-2" id="filter-form">
        <!-- Filter Form Start -->
        <div class="col-sm-12">
            <div class="card height-equal">
                <div class="card-body basic-wizard important-validation">
                    <div id="msform p-3">
                        <div class="stepper-one row needs-validation custom-input" novalidate="">

                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="validationTooltip04">Problem</label>
                                <select class="form-control w-100 select2-state gridFilterElements">                                      
                                    <option value="" selected>Please select Problem</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid Problem.</div>
                            </div>
                            <div class="col-sm-3">
                                <div class="mb-3">
                                    <label class="required-validation">Customer Name</label>
                                    <input class="form-control gridFilterElements" id="filterCustomerName" type="text" placeholder="Name">
                                </div>
                            </div>
                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="stateSelect">State</label>
                                <select class="form-control w-100 select2-state gridFilterElements">
                                    <option value="" >Please select State</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid State.</div>
                            </div>
                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="citySelect">City</label>
                                <select class="form-control selectMode w-100 rounded border select2-city gridFilterElements">
                                    <option value="" >Please select City</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid City.</div>
                            </div>
                            <div class="col-md-3 position-relative">
                                <label class="form-label" for="plumberSelect">Plumber</label>
                                <select class="form-control w-100 select2-state gridFilterElements">
                                    <option value="" selected disabled>Please select Plumber</option>
                                </select>
                                <div class="invalid-tooltip">Please select a valid Plumber.</div>
                            </div>
                            <div class="col-sm-3">
                                <div class="mb-3">
                                    <label class="required-validation">Manufacturer</label>
                                    <select class="form-control w-100 select2-state gridFilterElements">
                                        <option value="" selected disabled>Please select Manufacturer</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-sm-3">
                                <div class="mb-3">
                                    <label class="required-validation">Brand</label>
                                    <select class="form-control w-100 select2-state gridFilterElements">
                                        <option value="" selected disabled>Please select Brand</option>
                                    </select>
                                </div>
                            </div>
                            <div class="wizard-footer d-flex justify-content-end gap-2 col-lg-12 col-md-12 col-sm-12 mt-3">
                                <button class="btn btn-primary" onclick="GridPagination('complainList_Grid',1,'@gridUrl','ClientUserID')">Search</button>
                                <button class="btn btn-danger" onclick="Clearfilter(); GridPagination('complainList_Grid',1,'@gridUrl','ClientUserID');" type="button">Clear</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Filter Form end -->
    </div>
</div>
<div id="employeeList_Grid">
    <partial name="_Partial_Employee_GridBody" />
</div>