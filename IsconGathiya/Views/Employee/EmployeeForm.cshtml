@using IsconGathiya.ViewModel
@model EmployeeViewModel

@{
    ViewData["Title"] = Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row align-items-center">
            <div class="col-6">
                <h4>@(Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee")</h4>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Employee</li>
                        <li class="breadcrumb-item active" aria-current="page">@(Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="vertical-main-wizard">
                        <div class="row">
                            <div class="col-xxl-12 col-xl-12 col-12">
                                <div class="tab-content" id="wizard-tabContent">
                                    <div class="tab-pane fade show active px-4" id="wizard-contact" role="tabpanel" aria-labelledby="wizard-contact-tab" novalidate>
                                        <form asp-route="Employee_Save" class="needs-validation custom-input" method="post">
                                            <input type="hidden" asp-for="employeeDetails.EmployeeId" value="@Model.employeeDetails.EmployeeId" />
                                            <input type="hidden" id="countryDropDown" value="@Model.employeeDetails.CountryId" />
                                            <input type="hidden" id="StateId" value="@Model.employeeDetails.StateId">
                                            <input type="hidden" id="CityId" value="@Model.employeeDetails.CityId" />

                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Personal Information</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="staffId">Staff ID<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control" asp-for="employeeDetails.StaffId" placeholder="Enter staff ID" required>
                                                    <span asp-validation-for="employeeDetails.StaffId" class="text-danger"></span>

                                                </div>
                                                
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="adharNo">Branch<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <select class="form-control w-100 select2-state"
                                                            id="BranchDropDown"
                                                            asp-for="employeeDetails.BranchId"
                                                            asp-items="@(new SelectList(Model.employeeDetails.BranchList, "BranchId", "BranchName"))"
                                                            data-placeholder="Select Branch" required>
                                                        <option value="">Select Branch</option>
                                                    </select>
                                                    <span asp-validation-for="employeeDetails.BranchId" class="text-danger"></span>
                                                </div>

                                            </div>

                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="birthDate">Birth Date<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="date" class="form-control" asp-for="employeeDetails.BirthDate" id="birthDate" required>
                                                    <span asp-validation-for="employeeDetails.BirthDate" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="gender">Gender<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    @if (Model.GenderTypeList != null && Model.GenderTypeList.Any())
                                                    {
                                                        <select class="form-control w-100 domain-name-dropdown te gridFilterElements select2-example"
                                                                id="genderDropdown" asp-for="employeeDetails.Gender"
                                                                asp-items="Model.GenderTypeList"
                                                                data-placeholder="Select Gender" required>
                                                            <option value="">Select Gender</option>
                                                        </select>
                                                    }
                                                    <span asp-validation-for="employeeDetails.Gender" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="firstName">First Name<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control" asp-for="employeeDetails.EmployeeName" id="firstName" placeholder="Enter first name" required>
                                                    <span asp-validation-for="employeeDetails.EmployeeName" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <!-- Contact Information Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Contact Information</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="email">Email</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="email" class="form-control " asp-for="employeeDetails.Email" id="email" placeholder="Enter email">
                                                    <span asp-validation-for="employeeDetails.Email" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="mobileNumber">Mobile Number<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " id="mobileNumber" asp-for="employeeDetails.MobileNumber" placeholder="Enter mobile number" required>
                                                    <span asp-validation-for="employeeDetails.MobileNumber" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="whatsappNumber">WhatsApp Number</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.WhatsAppNumber" id="whatsappNumber" placeholder="Enter WhatsApp number">
                                                    <span asp-validation-for="employeeDetails.WhatsAppNumber" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="alternateNumber">Alternate Number</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.AlternateNumber" id="alternateNumber" placeholder="Enter alternate number">
                                                    <span asp-validation-for="employeeDetails.AlternateNumber" class="text-danger"></span>
                                                </div>
                                            </div>

                                            @*  <div class="col-md-6">
                                                <label class="form-label" for="countryDropDown">Country</label>
                                                <select class="form-control w-100 select2-state"
                                                        id="countryDropDown"
                                                        onchange="loadStatesByCountry(this.value)"
                                                        asp-for="employeeDetails.CountryId"
                                                        asp-items="@(new SelectList(Model.employeeDetails.CountryList, "Id", "Name", "101"))"
                                                        data-placeholder="Select Country" required>
                                                </select>
                                                <span asp-validation-for="employeeDetails.CountryId" class="text-danger"></span>

                                            </div> *@
                                            <!-- Address Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Address Details</h5>

                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="stateDropDown">State<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <select class="form-control w-100 select2-state"
                                                            id="stateDropDown"
                                                            onchange="loadCitiesByState(this.value)"
                                                            asp-for="employeeDetails.StateId"
                                                            data-placeholder="Select State" required>
                                                        <option value="">-- Select State --</option>
                                                    </select>
                                                    <span asp-validation-for="employeeDetails.StateId" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="cityDropDown">City<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <select class="form-control w-100 select2-state"
                                                            id="cityDropDown"
                                                            asp-for="employeeDetails.CityId"
                                                            data-placeholder="Select City" required>
                                                        <option value="">-- Select City --</option>
                                                    </select>
                                                    <span asp-validation-for="employeeDetails.CityId" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="address">Address<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <textarea class="form-control " id="address" rows="3" asp-for="employeeDetails.Address" placeholder="Enter full address" required></textarea>
                                                    <span asp-validation-for="employeeDetails.Address" class="text-danger"></span>
                                                </div>
                                            </div>


                                            <!-- Employment Details Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Employment Details</h5>
                                            @{
                                                var today = DateTime.Now.ToString("yyyy-MM-dd");
                                            }
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="joiningDate">Joining Date<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="date" class="form-control " max="@today" asp-for="employeeDetails.JoiningDate" id="joiningDate" required>
                                                    <span asp-validation-for="employeeDetails.JoiningDate" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="employeeType">Employee Type<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    @if (Model.EmployeeTypeList != null && Model.EmployeeTypeList.Any())
                                                    {
                                                        <select class="form-control w-100 domain-name-dropdown te gridFilterElements select2-example"
                                                                id="employeeDropdown" asp-for="employeeDetails.EmployeeType"
                                                                asp-items="Model.EmployeeTypeList"
                                                                data-placeholder="Select LabourType" required>
                                                            <option value="">Select EmployeeType</option>
                                                        </select>
                                                    }
                                                    <span asp-validation-for="employeeDetails.EmployeeType" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <!-- Salary -->
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="salary">Salary <span class="text-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control" id="salary" asp-for="employeeDetails.Salary" placeholder="Enter salary" required>
                                                    <span asp-validation-for="employeeDetails.Salary" class="text-danger"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="employeeType">Shift Type<span class="txt-danger">*</span></label>

                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    @if (Model.ShiftTypeList != null && Model.ShiftTypeList.Any())
                                                    {
                                                        <select class="form-control w-100 domain-name-dropdown te gridFilterElements select2-example"
                                                                id="ShiftDropdown" asp-for="employeeDetails.Shift"
                                                                asp-items="Model.ShiftTypeList"
                                                                data-placeholder="Select ShiftType" required>
                                                            <option value="">Select Shift</option>
                                                        </select>
                                                    }
                                                    <span asp-validation-for="employeeDetails.Shift" class="text-danger"></span>
                                                </div>
                                            </div>
                                            @{
                                                bool isActive = Model.employeeDetails.IsActive ?? false;
                                            }
                                            <div class="row mb-3">
                                                <!-- Is Active -->
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2 fs-6" for="isActive">Is Active<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12 my-2">
                                                    <div class="form-check-inline fs-6">
                                                        <input class="form-check-input form-check-lg" type="radio" name="employeeDetails.IsActive" id="active" value="true" @(isActive ? "checked" : "") />
                                                        <label class="form-check-label fs-6" for="active">Active</label>
                                                    </div>
                                                    <div class="form-check-inline fs-6">
                                                        <input class="form-check-input form-check-lg" type="radio" name="employeeDetails.IsActive" id="inactive" value="false" @(!isActive ? "checked" : "") />
                                                        <label class="form-check-label fs-6" for="inactive">InActive</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="education">Education</label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control " asp-for="employeeDetails.Education" id="education" placeholder="Enter education details">
                                                </div>
                                            </div>
                                            <!-- Document Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Documents</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="adharNo">Aadhar Number<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.AdharNo" id="adharNo" placeholder="Enter Aadhar number" required="">
                                                    <span asp-validation-for="employeeDetails.AdharNo" class="text-danger"></span>
                                                </div>
                                            </div>

                                            <!-- Save/Reset Buttons -->
                                            <div class="btn-showcase text-center">
                                                <button class="btn btn-primary" type="submit">Submit</button>
                                                <button class="btn btn-dark" type="reset">Reset</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>