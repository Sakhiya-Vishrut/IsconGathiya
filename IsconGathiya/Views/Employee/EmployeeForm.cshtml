@using IsconGathiya.ViewModel
@model EmployeeViewModel

@{
    ViewData["Title"] = Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee";
}

<div class="container-fluid">
    <div class="page-title">
        <div class="row align-items-center">
            <div class="col-6">
                <h4>@(Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee")</h4>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Employee</li>
                        <li class="breadcrumb-item active" aria-current="page">@(Model?.employeeDetails?.EmployeeId == 0 ? "Add Employee" : "Edit Employee")</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="vertical-main-wizard">
                        <div class="row">
                            <div class="col-xxl-12 col-xl-12 col-12">
                                <div class="tab-content" id="wizard-tabContent">
                                    <div class="tab-pane fade show active px-4" id="wizard-contact" role="tabpanel" aria-labelledby="wizard-contact-tab" novalidate>
                                        <form class="needs-validation custom-input" method="post">
                                            <input type="hidden" asp-for="employeeDetails.EmployeeId" />

                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Personal Information</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="staffId">Staff ID<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control" asp-for="employeeDetails.StaffId" placeholder="Enter staff ID" required>
                                                    <span asp-validation-for="employeeDetails.StaffId" class="invalid-feedback"></span>

                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="firstName">First Name<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control" asp-for="employeeDetails.EmployeeName" id="firstName" placeholder="Enter first name" required>
                                                    <span asp-validation-for="employeeDetails.EmployeeName" class="invalid-feedback"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="middleName">Middle Name</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control" asp-for="employeeDetails.MiddleName" id="middleName" placeholder="Enter middle name" required>
                                                    <span asp-validation-for="employeeDetails.MiddleName" class="invalid-feedback"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="lastName">Last Name<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control" asp-for="employeeDetails.LastName" id="lastName" placeholder="Enter last name" required>
                                                    <span asp-validation-for="employeeDetails.LastName" class="invalid-feedback"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="birthDate">Birth Date<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="date" class="form-control" asp-for="employeeDetails.BirthDate" id="birthDate" required>
                                                    <span asp-validation-for="employeeDetails.BirthDate" class="invalid-feedback"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="gender">Gender<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <select class="form-control " asp-for="employeeDetails.Gender" id="gender" required>
                                                        <option value="" disabled selected>Select gender</option>
                                                        <option value="male">Male</option>
                                                        <option value="female">Female</option>
                                                        <option value="other">Other</option>
                                                    </select>
                                                    <span asp-validation-for="employeeDetails.Gender" class="invalid-feedback"></span>
                                                </div>
                                            </div>

                                            <!-- Contact Information Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Contact Information</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="email">Email<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="email" class="form-control " asp-for="employeeDetails.Email" id="email" placeholder="Enter email" required>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="mobileNumber">Mobile Number<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " id="mobileNumber" asp-for="employeeDetails.MobileNumber" placeholder="Enter mobile number" required>
                                                    <span asp-validation-for="employeeDetails.MobileNumber" class="invalid-feedback"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="whatsappNumber">WhatsApp Number</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.WhatsAppNumber" id="whatsappNumber" placeholder="Enter WhatsApp number">
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="alternateNumber">Alternate Number</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.AlternateNumber" id="alternateNumber" placeholder="Enter alternate number">
                                                </div>
                                            </div>


                                            <!-- Address Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Address Details</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="state">State<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control " id="state" asp-for="employeeDetails.StateId" placeholder="Enter state" required>
                                                    <span asp-validation-for="employeeDetails.StateId" class="invalid-feedback"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="city">City<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control " id="city" asp-for="employeeDetails.CityId" placeholder="Enter city" required>
                                                    <span asp-validation-for="employeeDetails.CityId" class="invalid-feedback"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="address">Address<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <textarea class="form-control " id="address" rows="3" asp-for="employeeDetails.Address" placeholder="Enter full address" required></textarea>
                                                    <span asp-validation-for="employeeDetails.Address" class="invalid-feedback"></span>
                                                </div>
                                            </div>


                                            <!-- Employment Details Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Employment Details</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="joiningDate">Joining Date<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="date" class="form-control " asp-for="employeeDetails.JoiningDate" id="joiningDate" required>
                                                    <span asp-validation-for="employeeDetails.JoiningDate" class="invalid-feedback"></span>
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="employeeType">Employee Type<span class="txt-danger">*</span></label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <select class="form-control " asp-for="employeeDetails.EmployeeType" id="employeeType" required>
                                                        <option value="" disabled selected>Select employee type</option>
                                                        <option value="full-time">Full Time</option>
                                                        <option value="part-time">Part Time</option>
                                                        <option value="contract">Contract</option>
                                                    </select>
                                                    <span asp-validation-for="employeeDetails.EmployeeType" class="invalid-feedback"></span>
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="education">Education<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="text" class="form-control " asp-for="employeeDetails.Education" id="education" placeholder="Enter education details">
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="isActive">Is Active</label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="checkbox" class="form-check-input" id="isActive" checked>
                                                </div>
                                            </div>

                                            <!-- Document Section -->
                                            <h5 class="mb-4 fw-semibold" style="color: #006666;">Documents</h5>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="employeeImage">Employee Image</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="file" class="form-control " asp-for="employeeDetails.EmployeeImage" id="employeeImage" accept="image/*">
                                                </div>
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="adharCardImage">Aadhar Card Image</label>
                                                <div class="col-lg-4 col-md-9 col-sm-12">
                                                    <input type="file" class="form-control " asp-for="employeeDetails.AdharCardImage" id="adharCardImage" accept="image/*">
                                                </div>
                                            </div>
                                            <div class="row mb-3">
                                                <label class="form-label col-lg-2 col-md-3 col-sm-12 text-start my-2" for="adharNo">Aadhar Number<span class="txt-danger">*</span></label>
                                                <div class="col-lg-10 col-md-9 col-sm-12">
                                                    <input type="number" class="form-control " asp-for="employeeDetails.AdharNo" id="adharNo" placeholder="Enter Aadhar number" required>
                                                    <span asp-validation-for="employeeDetails.AdharNo" class="invalid-feedback"></span>
                                                </div>
                                            </div>


                                            <!-- Save/Reset Buttons -->
                                            <div class="btn-showcase text-center">
                                                <button class="btn btn-primary" type="submit">Submit</button>
                                                <button class="btn btn-dark" type="reset">Reset</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>