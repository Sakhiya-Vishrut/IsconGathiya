@model EmployeeViewModel
@using IsconGathiya.ViewModel


@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid py-4">
    <div class="page-title mb-4">
        <div class="row align-items-center">
            <div class="col-6">
                <h2 class="fw-bold text-primary">Employee Details</h2>
            </div>
            <div class="col-6 d-flex justify-content-end">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center text-decoration-none">
                                <svg class="stroke-icon me-2" width="24" height="24">
                                    <use href="~/assets/svg/icon-sprite.svg#stroke-home"></use>
                                </svg>
                                Home
                            </a>
                        </li>
                        <li class="breadcrumb-item">Employee</li>
                        <li class="breadcrumb-item active" aria-current="page">Employee Details</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Employee Profile</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <!-- Personal Information -->
                        <div class="col-12">
                            <h5 class="mb-3 fw-semibold text-secondary">Personal Information</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Staff ID</label>
                                        <p class="mb-0">@Model.employeeDetails.StaffId</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Branch</label>
                                        <p class="mb-0">
                                            @Model.employeeDetails.BranchList?.FirstOrDefault(b => b.BranchId == Model.employeeDetails.BranchId)?.BranchName
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">First Name</label>
                                        <p class="mb-0">@Model.employeeDetails.EmployeeName</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Birth Date</label>
                                        <p class="mb-0">@Model.employeeDetails.BirthDate?.ToString("dd MMMM yyyy")</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Gender</label>
                                        <p class="mb-0">@Model.employeeDetails.Gender</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="col-12">
                            <h5 class="mb-3 fw-semibold text-secondary">Contact Information</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Email</label>
                                        <p class="mb-0">@Model.employeeDetails.Email</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Mobile Number</label>
                                        <p class="mb-0">@Model.employeeDetails.MobileNumber</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">WhatsApp Number</label>
                                        <p class="mb-0">@Model.employeeDetails.WhatsAppNumber</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Alternate Number</label>
                                        <p class="mb-0">@Model.employeeDetails.AlternateNumber</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Address Details -->
                        <div class="col-12">
                            <h5 class="mb-3 fw-semibold text-secondary">Address Details</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">State</label>
                                        <p class="mb-0">
                                            @Model.employeeDetails.StateList?.FirstOrDefault(s => s.Id == Model.employeeDetails.StateId)?.Name
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">City</label>
                                        <p class="mb-0">
                                            @Model.employeeDetails.CityList?.FirstOrDefault(c => c.Id == Model.employeeDetails.CityId)?.Name
                                        </p>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Address</label>
                                        <p class="mb-0">@Model.employeeDetails.Address</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Employment Details -->
                        <div class="col-12">
                            <h5 class="mb-3 fw-semibold text-secondary">Employment Details</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Joining Date</label>
                                        <p class="mb-0">@Model.employeeDetails.JoiningDate?.ToString("dd MMMM yyyy")</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Employee Type</label>
                                        <p class="mb-0">@Model.employeeDetails.EmployeeType</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Salary</label>
                                        <p class="mb-0">@Model.employeeDetails.Salary</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Shift Type</label>
                                        <p class="mb-0">@Model.employeeDetails.Shift</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Status</label>
                                        <p class="mb-0">
                                            <span class="badge @(@Model.employeeDetails.IsActive == true ? "bg-success" : "bg-danger")">
                                                @(@Model.employeeDetails.IsActive == true ? "Active" : "Inactive")
                                            </span>
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Education</label>
                                        <p class="mb-0">@Model.employeeDetails.Education</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Document Details -->
                        <div class="col-12">
                            <h5 class="mb-3 fw-semibold text-secondary">Documents</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="bg-light p-3 rounded">
                                        <label class="form-label fw-bold text-muted mb-1">Aadhar Number</label>
                                        <p class="mb-0">@Model.employeeDetails.AdharNo</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Back Button -->
                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-primary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

