<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IsconGathiya</title>
    <link rel="shortcut icon" type="image/png" href="~/assets/images/IGLogo.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IsconGathiya.styles.css" asp-append-version="true" />

    <link href="@Url.Content("~/assets/vendor/jquery-nice-select/css/nice-select.css")" rel="stylesheet">
    <link href="@Url.Content("~/assets/vendor/swiper/css/swiper-bundle.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/assets/vendor/bootstrap-datetimepicker/css/bootstrap-datetimepicker.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/assets/vendor/bootstrap-select/dist/css/bootstrap-select.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/assets/vendor/select2/css/select2.min.css")" rel="stylesheet">
    <link href="@Url.Content("~/assets/vendor/datatables/css/jquery.dataTables.min.css")" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/dev-style.css")">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Global Stylesheet -->
    <link href="@Url.Content("~/assets/css/style.css")" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Your custom styles (should be last to override conflicting styles if necessary) -->
    <link href="@Url.Content("~/assets/css/dev-style.css")" rel="stylesheet">
</head>
<body>
    <partial name="_Partial/_Loader" />

    <div id="main-wrapper">
        <partial name="_Partial/_Hadder" />
        <partial name="_Partial/_Sidebar" />
        <div class="content-body">
            @RenderBody()
        </div>
    </div>
    <partial name="_Partial/_Footer" />


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- jQuery (necessary for DataTables and Select2) -->
    <!-- 1. jQuery (Only if needed, for compatibility with older plugins) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- 2. Bootstrap JS Bundle (includes Popper.js) -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> *@

    <!-- 3. SweetAlert2 (if you're using it) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!--Ck Editor CDN-->
    <script src="https://cdn.ckeditor.com/ckeditor5/34.0.0/classic/ckeditor.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <!-- 4. Vendor JS    (third-party plugins) -->
    <script src="@Url.Content("~/assets/vendor/bootstrap-select/dist/js/bootstrap-select.min.js")"></script>
    <script src="@Url.Content("~/assets/vendor/swiper/js/swiper-bundle.min.js")"></script>
    <script src="@Url.Content("~/assets/vendor/jquery-nice-select/js/jquery.nice-select.min.js")"></script>
    <script src="@Url.Content("~/assets/vendor/global/global.min.js")"></script>
    <script src="@Url.Content("~/assets/vendor/select2/js/select2.full.min.js")"></script>
    <script src="@Url.Content("~/assets/vendor/datatables/js/jquery.dataTables.min.js")"></script>

    <!-- 5. Initialize Plugins (initialization scripts for plugins) -->
    <script src="@Url.Content("~/assets/js/plugins-init/select2-init.js")"></script>
    <script src="@Url.Content("~/assets/js/plugins-init/datatables.init.js")"></script>

    <!-- 6. Custom JS (your custom scripts that depend on plugins or the page) -->
    <script src="@Url.Content("~/assets/js/dlabnav-init.js")"></script>
    <script src="@Url.Content("~/assets/js/custom.js")"></script>
    <script src="@Url.Content("~/assets/js/demo.js")"></script>
    @*     <script src="@Url.Content("~/assets/js/styleSwitcher.js")"></script>
 *@
    <!-- 7. Page-Specific JS (scripts related to specific pages or views) -->
    <script src="@Url.Content("~/view-js/common.js")"></script>
    <script src="@Url.Content("~/view-js/dev-script.js")"></script>
    <script src="@Url.Content("~/view-js/pagination.js")"></script>
    <script src="@Url.Content("~/view-js/location-dropdown.js")"></script>

    <!-- 8. Validation Scripts (for form validation, make sure these come after jQuery) -->
    <script src="@Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js")"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/34.0.0/classic/ckeditor.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
